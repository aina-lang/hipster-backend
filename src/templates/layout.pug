doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="light")
    meta(name="supported-color-schemes" content="light")
    title #{subject}
    style.
      @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

      body {
        font-family: 'Plus Jakarta Sans', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #ffffff;
        margin: 0;
        padding: 0;
        color: #4A3B30;
      }
      table { border-collapse: collapse; }
      a { color: #5C4433; }
      .bg-wrap {
        background-color: #ffffff;
        padding: 32px 16px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #EFE1CE;
        box-shadow: 0 20px 45px -18px rgba(58, 42, 30, 0.22);
      }
      .hero {
        line-height: 0;
        background-color: #1C1815;
      }
      .hero img {
        width: 100%;
        height: auto;
        max-height: 260px;
        object-fit: cover;
        display: block;
      }
      .content {
        padding: 44px 40px;
        font-size: 16px;
        line-height: 1.65;
      }
      h1, h2, h3 {
        color: #3A2A1E;
        margin-top: 0;
        font-weight: 800;
        letter-spacing: -0.01em;
      }
      h2 {
        font-size: 24px;
        margin-bottom: 4px;
      }
      .title-accent {
        width: 44px;
        height: 4px;
        margin: 0 0 22px;
        border-radius: 999px;
        background: #5C4433;
      }
      p {
        color: #5B4636;
        margin: 0 0 22px;
      }
      strong { color: #3A2A1E; }
      .btn {
        display: inline-block;
        background: #5C4433;
        color: #FFF8EF !important;
        text-decoration: none;
        padding: 16px 34px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        box-shadow: 0 10px 24px -8px rgba(92, 68, 51, 0.45);
      }
      .btn-secondary {
        display: inline-block;
        background: #ffffff;
        color: #5C4433 !important;
        text-decoration: none;
        padding: 15px 32px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border: 1.5px solid #E8D9C5;
      }
      .card {
        background: #FFFDFA;
        border: 1px solid #F1E4D0;
        border-radius: 20px;
        padding: 28px;
        margin: 32px 0;
        box-shadow: 0 10px 30px -14px rgba(92, 68, 51, 0.15);
      }
      .card-title {
        margin: 0 0 18px;
        font-size: 17px;
        font-weight: 800;
        color: #3A2A1E;
        padding-bottom: 14px;
        border-bottom: 1.5px solid #F1E4D0;
      }
      .row-label {
        padding: 12px 0;
        font-size: 13px;
        color: #8A7566;
        font-weight: 600;
      }
      .row-value {
        padding: 12px 0;
        font-size: 14px;
        color: #3A2A1E;
        font-weight: 700;
        text-align: right;
      }
      .row-sep { border-top: 1px solid #F1E4D0; }
      .eyebrow {
        font-size: 11px;
        color: #A8886E;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
      }
      .id-card {
        background: #FFFDFA;
        border: 1px solid #F1E4D0;
        border-radius: 18px;
        padding: 24px 16px;
        text-align: center;
      }
      .id-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #5C4433;
        display: inline-block;
        text-align: center;
        line-height: 48px;
        margin-bottom: 14px;
      }
      .id-card-label {
        font-size: 11px;
        color: #A8886E;
        text-transform: uppercase;
        letter-spacing: 1.3px;
        font-weight: 700;
        margin: 0 0 6px;
      }
      .id-card-value {
        font-size: 15px;
        color: #3A2A1E;
        font-weight: 800;
        margin: 0;
        word-break: break-word;
      }
      .icon-circle {
        width: 68px;
        height: 68px;
        background: #FBF3E7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border: 1px solid #EFDCC0;
        font-size: 28px;
      }
      .badge {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .badge-success { background-color: #EAF4EC; color: #2F6F4E; border: 1px solid #D2E7DA; }
      .badge-danger { background-color: #FBECE8; color: #A14A3A; border: 1px solid #F0D6CC; }
      .badge-warning { background-color: #FBF2E3; color: #9A6B2E; border: 1px solid #F0DFC0; }
      .badge-neutral { background-color: #F3EEE5; color: #6E4A35; border: 1px solid #E8D9C5; }
      .info-box {
        border-radius: 14px;
        padding: 20px;
        margin: 24px 0;
        font-size: 14px;
        line-height: 1.65;
      }
      .info-box p { margin: 0; }
      .info-box-brand { background-color: #FBF6EE; border-left: 4px solid #8B5E3C; color: #5B4636; }
      .info-box-success { background-color: #EEF6F0; border-left: 4px solid #3F9163; color: #2F6F4E; }
      .info-box-danger { background-color: #FBEEEA; border-left: 4px solid #C2604B; color: #A14A3A; }
      .info-box-warning { background-color: #FDF6E9; border-left: 4px solid #D89A3E; color: #9A6B2E; }
      .info-box-blue { background-color: #EEF3FB; border-left: 4px solid #4C74B9; color: #35507F; }
      .info-line {
        font-size: 14px;
        color: #5B4636;
        line-height: 1.6;
        margin: 24px 0;
      }
      .info-line-icon {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background-color: #3A2A1E;
        color: #ffffff !important;
        text-align: center;
        line-height: 26px;
        font-size: 13px;
        font-weight: 800;
        font-style: italic;
        display: inline-block;
      }
      .code-box {
        background-color: #FBF6EE;
        border: 1px solid #F1E4D0;
        border-radius: 16px;
        padding: 36px 20px;
        margin: 32px 0;
        text-align: center;
      }
      .code {
        font-size: 40px;
        font-weight: 800;
        letter-spacing: 10px;
        color: #3A2A1E;
        font-family: 'SFMono-Regular', Consolas, Menlo, monospace;
        display: inline-block;
        padding: 10px 22px;
        border: 1px solid #F1E4D0;
        border-radius: 12px;
        background-color: #ffffff;
      }
      .divider {
        height: 1px;
        background-color: #F1E4D0;
        margin: 32px 0;
      }
      .footer {
        text-align: center;
        padding: 36px 32px 40px;
        background-color: #FBF6EE;
        border-top: 1px solid #F1E4D0;
      }
      .footer-mark {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        overflow: hidden;
        display: inline-block;
        margin-bottom: 14px;
        border: 1px solid #EFDCC0;
        background-color: #ffffff;
      }
      .footer-mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .footer-brand {
        font-size: 14px;
        font-weight: 800;
        color: #3A2A1E;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin: 0 0 18px;
      }
      .social-row { margin-bottom: 20px; }
      .social-icon {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #3A2A1E;
        color: #ffffff !important;
        text-align: center;
        line-height: 32px;
        font-size: 13px;
        font-weight: 700;
        margin: 0 4px;
      }
      .footer-help {
        font-size: 13px;
        color: #6E4A35;
        margin: 0 0 16px;
      }
      .footer-help a { color: #6E4A35; font-weight: 700; text-decoration: none; }
      .footer-tagline {
        font-size: 10px;
        color: #A8886E;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-weight: 700;
        margin: 0 0 10px;
      }
      .footer-website a {
        font-size: 12px;
        color: #8A7566;
        text-decoration: none;
      }
      .company-info {
        font-size: 12px;
        color: #A8886E;
        line-height: 1.6;
        margin-top: 18px;
      }
      .company-info a { color: #8A7566; text-decoration: none; }

  body
    .bg-wrap
      .container
        if heroImageUrl
          .hero
            img(src=heroImageUrl alt=companyName)

        .content
          block content

        .footer
          div(style="margin: 32px 0;")
            div(style="border-bottom: 1px solid #E8D9C5; margin-bottom: 20px;")
            div(style="text-align: center;")
              if companyLogoUrl
                div(style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 10px;")
                  div(style="flex: 1; height: 1px; background: #E8D9C5;")
                  img(src=companyLogoUrl alt=companyName style="display: block; width: 44px; height: 44px; border-radius: 50%; border: 1px solid #E8D9C5; background-color: #ffffff; flex-shrink: 0;")
                  div(style="flex: 1; height: 1px; background: #E8D9C5;")
              p(style="font-size: 14px; font-weight: 800; color: #3A2A1E; letter-spacing: 0.18em; text-transform: uppercase; margin: 0;") #{companyName}

          .social-row
            span.social-icon f
            span.social-icon(style="font-size: 10px;") IG
            span.social-icon in

          p.footer-help
            | Besoin d'aide ?&nbsp;
            if companyEmail
              a(href=`mailto:${companyEmail}` style="color: #6E4A35; text-decoration: none;") #{companyEmail}

          p.footer-tagline Développement web &bull; Communication &bull; Marketing

          if companyWebsite
            p.footer-website
              a(href=companyWebsite style="color: #8A7566; text-decoration: none;") #{companyWebsite.replace(/^https?:\/\//, '')}

          .company-info
            if companyAddress
              | #{companyAddress}
              if companyCity
                |, #{companyCity}
              if companyZipCode
                |  #{companyZipCode}
              br
            if companyPhone
              | Tél : #{companyPhone}
            br

          div(style="margin-top: 16px;")
            p(style="font-size: 11px; color: #C9B6A3; margin: 0;") © #{currentYear} #{companyName}. Tous droits réservés.
